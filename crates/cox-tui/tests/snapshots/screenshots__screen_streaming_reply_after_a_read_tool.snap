  //! The agent loop as a state machine.

  pub fn step(&mut self, sub: Submission) -> Vec<Event> {
      self.turns.push(Turn::from(sub));
      self.assemble_context()
  }
  ✓ 164B 12ms
The loop is a state machine: Submission in, Event out.

• context is assembled per turn from the instruction files and the last two turns verbatim
• compaction never edits earlier turns in place

let events = session.step(Submission::UserTurn { text, .. });

