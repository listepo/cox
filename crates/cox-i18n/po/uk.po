#. The window and app title: the product name.
#, python-brace-format
msgctxt "app-title"
msgid "{brand}"
msgstr "{brand}"

msgctxt "settings-title"
msgid "Settings"
msgstr "Налаштування"

#. Menu item that quits the app.
#, python-brace-format
msgctxt "quit-app"
msgid "Quit {brand}"
msgstr "Вийти з {brand}"

#. {name} (string): the user's display name.
#, python-brace-format
msgctxt "welcome-user"
msgid "Welcome to {brand}, {name}!"
msgstr "Ласкаво просимо до {brand}, {name}!"

#. {count} (number): open sessions in the sidebar.
#, python-brace-format
msgctxt "session-count"
msgid "{count} session"
msgid_plural "{count} sessions"
msgstr[0] "{count} сесія"
msgstr[1] "{count} сесії"
msgstr[2] "{count} сесій"

# cldr-other: {name} змінює {count} файлу
#. {name} (string): who made the change; {count} (number): changed files.
#, python-brace-format
msgctxt "files-changed"
msgid "{name} changed {count} file"
msgid_plural "{name} changed {count} files"
msgstr[0] "{name} змінює {count} файл"
msgstr[1] "{name} змінює {count} файли"
msgstr[2] "{name} змінює {count} файлів"

