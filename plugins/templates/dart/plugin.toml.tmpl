# Generated by `cox plugin new {{id}} --lang dart` (PL§13). Dart cannot
# emit a wasm module extism can load (dart-lang/sdk#56366 is still open;
# research.md §4.3.5 P44 re-checked Dart 3.13.4 against this workspace's
# pinned extism/wasmtime and the module still fails to instantiate). So a
# Dart plugin's only v1 capability is this `[[mcp]]` stdio server — no
# capabilities table, no wasm export — and `cox plugin new --lang dart
# --with` only accepts `tool`/`mcp` (both scaffold this same server).
#
# KNOWN GAP as of this scaffold (cox plan.md T33.38): the host's loader
# (`crates/cox/src/session.rs` `load_plugins`) always reads `wasm` and only
# starts a plugin's `[[mcp]]` servers once that read succeeds; `wasm` below
# is a required field with no wasm-less path yet. This package ships no
# `plugin.wasm` by design, so until the host is changed, `cox plugin
# install` stages it but the mcp server never starts. See plan.md T33.38
# for the tracked follow-up.
api = 1
id = "{{id}}"
version = "0.1.0"
name = "{{id}}"
description = "A cox plugin"
wasm = "plugin.wasm"

[[mcp]]
name = "{{id}}"
command = "build/{{crate_name}}"
